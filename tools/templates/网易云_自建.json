{
  "name": "网易云音乐（自建）",
  "version": "1.0.0",
  "baseUrl": "http://192.168.1.100:3000",
  "headers": {},
  "search": {
    "path": "/cloudsearch",
    "method": "GET",
    "keywordParam": "keywords",
    "params": {"limit": 30},
    "body": {}
  },
  "mapping": {
    "list": "result.songs",
    "id": "id",
    "title": "name",
    "artist": "ar",
    "album": "al.name",
    "cover": "al.picUrl",
    "url": "",
    "urlResolve": {
      "path": "/song/url/v1?id={id}&level=standard",
      "method": "GET",
      "urlPath": "data.0.url",
      "body": {}
    },
    "duration": "dt",
    "durationUnit": "ms"
  }
}
