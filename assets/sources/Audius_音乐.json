{
  "name": "Audius 音乐",
  "version": "1.0.0",
  "baseUrl": "https://discoveryprovider.audius.co",
  "headers": {},
  "search": {
    "path": "/v1/tracks/search",
    "method": "GET",
    "keywordParam": "query",
    "params": {
      "app_name": "zephyr",
      "limit": 30
    },
    "body": {}
  },
  "mapping": {
    "list": "data",
    "id": "id",
    "title": "title",
    "artist": "user.name",
    "album": "",
    "cover": "artwork.480x480",
    "url": "",
    "urlTemplate": "https://discoveryprovider.audius.co/v1/tracks/{id}/stream?app_name=zephyr",
    "duration": "duration",
    "durationUnit": "s"
  }
}
