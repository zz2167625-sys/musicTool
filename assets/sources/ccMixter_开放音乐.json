{
  "name": "ccMixter 开放音乐",
  "version": "1.0.0",
  "baseUrl": "https://ccmixter.org",
  "headers": {
    "Accept": "application/json",
    "Referer": "https://ccmixter.org/"
  },
  "notes": "CC 授权完整歌曲，英文关键词命中率更高",
  "search": {
    "path": "/api/query",
    "method": "GET",
    "keywordParam": "search",
    "params": {
      "f": "json",
      "limit": 15
    },
    "body": {}
  },
  "mapping": {
    "list": "",
    "id": "upload_id",
    "title": "upload_name",
    "artist": "user_name",
    "album": "",
    "cover": "",
    "url": "files.0.download_url",
    "duration": "",
    "durationUnit": "s",
    "checkPlayable": true
  }
}
